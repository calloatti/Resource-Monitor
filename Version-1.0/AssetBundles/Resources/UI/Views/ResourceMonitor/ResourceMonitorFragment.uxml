<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:cui="Timberborn.CoreUI" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="/Assets/Resources/UI/Views/Core/CoreStyle.uss" />
    <Style src="/Assets/Resources/UI/Views/Common/CommonStyle.uss" />
    <Style src="/Assets/Resources/UI/Views/Common/EntityPanel/EntityPanelCommonStyle.uss" />
    <Style src="/Assets/Resources/UI/Views/Game/EntityPanel/EntityPanelGameStyle.uss" />
    <ui:VisualElement name="ResourceCounterFragment">
        <cui:NineSliceVisualElement name="ModeRadioToggleContainer" class="entity-sub-panel bg-sub-box--green" />
        <cui:NineSliceVisualElement name="BottomSection" class="entity-sub-panel bg-sub-box--green automation-counter-fragment">
            <Timberborn.DropdownSystem.Dropdown name="Good" class="automation-counter-fragment__primary-dropdown game-dropdown" />
            <cui:LocalizableToggle name="Toggle" text="Include inputs" text-loc-key="Building.ResourceCounter.IncludeInputs" class="game-toggle automation-counter-fragment__toggle" style="margin-top: 14px; margin-bottom: 13px;" />
            <ui:Label name="Measurement" class="game-text-big automation-counter-fragment__measurement" />
            <ui:Label name="OnTitle" class="game-text-normal" style="margin-top: 10px;" />
            <ui:VisualElement name="ComparisonWrapper" class="automation-counter-fragment__threshold-wrapper">
                <cui:NineSliceIntegerField name="Threshold" max-length="9" class="entity-panel-setting__input entity-panel-input automation-fragment__integer-input" />
            </ui:VisualElement>
            <ui:Label name="FillRateLabel" text="50%" class="game-text-big automation-counter-fragment__threshold" />
            <cui:PreciseSlider name="FillRateSlider" class="automation-counter-slider" />
            <ui:Label name="OffTitle" class="game-text-normal" style="margin-top: 10px;" />
            <ui:VisualElement name="OffComparisonWrapper" class="automation-counter-fragment__threshold-wrapper">
                <cui:NineSliceIntegerField name="ThresholdOff" max-length="9" class="entity-panel-setting__input entity-panel-input automation-fragment__integer-input" style="margin-bottom: 13px;" />
            </ui:VisualElement>
            <ui:Label name="FillRateLabelOff" text="80%" class="game-text-big automation-counter-fragment__threshold" />
            <cui:PreciseSlider name="FillRateSliderOff" class="automation-counter-slider" />
        </cui:NineSliceVisualElement>
    </ui:VisualElement>
</ui:UXML>